# Copy to backend/.env and adjust for your local environment.

APP_NAME=Signaler API
ENVIRONMENT=development
DEBUG=true

# SQLite database file, relative to the backend directory.
DATABASE_URL=sqlite:///./signaler.db

# Comma-separated list of origins allowed by CORS (Next.js dev server).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Placeholders for future authentication. Replace with a real secret before use.
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
