# Copy to backend/.env and adjust for your local environment.

APP_NAME=Signaler API
ENVIRONMENT=development
DEBUG=true

# SQLite database file, relative to the backend directory. A managed Postgres
# URL (postgres://... or postgresql://...) is also accepted and is normalised
# to the psycopg driver automatically -- see Settings.sqlalchemy_url.
DATABASE_URL=sqlite:///./signaler.db

# Comma-separated list of origins allowed by CORS (Next.js dev server).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional regex for origins whose hostname changes per deployment, such as
# Vercel previews. Leave empty locally. Anchor any pattern at both ends.
CORS_ORIGIN_REGEX=

# Access-token signing. Anyone holding this value can forge a token for any
# account, so a deployment must set its own; never reuse this development one.
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# TURN relay for calls where STUN alone cannot connect the two peers --
# symmetric NAT, a strict corporate/carrier firewall. From a Metered.ca
# dashboard (free tier, https://www.metered.ca/tools/openrelay/): the
# per-account subdomain and its API key. Left blank, calls still work
# wherever STUN alone is enough -- only the TURN fallback is missing, and it
# fails the way "Could not connect" describes rather than erroring outright.
METERED_TURN_DOMAIN=
METERED_TURN_API_KEY=
